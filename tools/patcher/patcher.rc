#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "patcher_version.h"

IDD_PATCHER DIALOGEX 0, 0, 456, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "First Queen IV"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "", IDC_HEADING, 12, 7, 88, 24, SS_CENTERIMAGE
    LTEXT           FQ4_HEADER, IDC_VERSION, 104, 10, 340, 19, SS_CENTERIMAGE

    LTEXT           "", IDC_LANGUAGE_LABEL, 12, 43, 86, 12, SS_CENTERIMAGE
    AUTORADIOBUTTON "繁體中文", IDC_TRADITIONAL, 12, 60, 86, 17, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "简体中文", IDC_SIMPLIFIED, 12, 80, 86, 17

    LTEXT           "", IDC_SOURCE_LABEL, 118, 43, 326, 12, SS_CENTERIMAGE
    CONTROL         "", IDC_SOURCE, "Edit", WS_TABSTOP | ES_AUTOHSCROLL, 126, 63, 248, 11
    PUSHBUTTON      "", IDC_BROWSE, 388, 60, 56, 17

    LTEXT           "", IDC_MODE_LABEL, 118, 87, 326, 12, SS_CENTERIMAGE
    LTEXT           "", IDC_MEMORY_LABEL, 126, 103, 84, 17, SS_CENTERIMAGE
    LTEXT           "", IDC_MEMORY_DETAIL, 218, 103, 218, 17, SS_CENTERIMAGE
    LTEXT           "", IDC_DISK_LABEL, 126, 123, 84, 17, SS_CENTERIMAGE
    LTEXT           "", IDC_DISK_DETAIL, 218, 123, 218, 17, SS_CENTERIMAGE
    LTEXT           "", IDC_STATUS, 118, 149, 326, 17, SS_CENTERIMAGE | SS_ENDELLIPSIS | SS_NOPREFIX

    PUSHBUTTON      "", IDC_LAUNCH, 12, 183, 140, 17, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "", IDC_WRITE, 158, 183, 140, 17
    PUSHBUTTON      "", IDCANCEL, 304, 183, 140, 17
END

IDR_PAYLOAD RCDATA "payload.bin"
IDR_PAYLOAD_CN RCDATA "payload_cn.bin"

1 VERSIONINFO
FILEVERSION FQ4_VERSION_NUMERIC
PRODUCTVERSION FQ4_VERSION_NUMERIC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "First Queen IV Chinese Patch"
            VALUE "FileVersion", FQ4_VERSION
            VALUE "ProductName", "First Queen IV Chinese Patch"
            VALUE "ProductVersion", FQ4_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
