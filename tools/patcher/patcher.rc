#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "patcher_version.h"

IDD_PATCHER DIALOGEX 0, 0, 318, 109
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION FQ4_CAPTION
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "日文版游戏 EXE", -1, 12, 10, 250, 11
    EDITTEXT        IDC_SOURCE, 12, 25, 240, 11, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览…", IDC_BROWSE, 258, 25, 48, 11
    LTEXT           "游戏语言", -1, 12, 43, 49, 12
    AUTORADIOBUTTON "繁體中文", IDC_TRADITIONAL, 68, 42, 66, 13, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "简体中文", IDC_SIMPLIFIED, 140, 42, 66, 13
    LTEXT           "", IDC_STATUS, 12, 60, 294, 12
    PUSHBUTTON      "生成中文版 EXE", IDC_WRITE, 12, 78, 144, 21, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "以内存补丁启动", IDC_LAUNCH, 162, 78, 144, 21
END

IDR_PAYLOAD RCDATA "payload.bin"
IDR_PAYLOAD_CN RCDATA "payload_cn.bin"

1 VERSIONINFO
FILEVERSION FQ4_VERSION_NUMERIC
PRODUCTVERSION FQ4_VERSION_NUMERIC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "First Queen IV Chinese Patch"
            VALUE "FileVersion", FQ4_VERSION
            VALUE "ProductName", "First Queen IV Chinese Patch"
            VALUE "ProductVersion", FQ4_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
